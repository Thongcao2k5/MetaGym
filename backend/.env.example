NODE_ENV=development
PORT=3000
# Enable request approval, draft publication and training sessions used by the Coach UI.
ENABLE_COACH_WORKFLOWS=false
# Dev Database UI at /database (enabled automatically when NODE_ENV!=production; set true to force-enable).
ENABLE_DB_UI=true
DB_UI_USERNAME=admin
DB_UI_PASSWORD=admin
DATABASE_URL=postgresql://postgres:password@localhost:5432/meta_gym
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=
VNPAY_TMN_CODE=
# Select new checkouts without disabling other gateways' callbacks/status queries.
PAYMENT_GATEWAY=ZALOPAY
VNPAY_HASH_SECRET=
VNPAY_PUBLIC_ORIGIN=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PUBLIC_ORIGIN=
MOMO_WEB_RETURN_URL=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_PUBLIC_ORIGIN=
# Optional HTTPS Flutter Web URL to the membership screen, including the hash route if used.
VNPAY_WEB_RETURN_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=
CALL_TOKEN_SERVICE_URL=
CALL_TOKEN_SERVICE_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEDIA_STORAGE_DIR=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_REALTIME_JWT_SECRET=
SMOKE_API_BASE_URL=http://localhost:3000/api/v1
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_COACH_EMAIL=
SMOKE_COACH_PASSWORD=
SMOKE_MEMBER_EMAIL=
SMOKE_MEMBER_PASSWORD=
